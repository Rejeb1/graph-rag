# LLM provider — free, from console.groq.com, no card required
GROQ_API_KEY=

# Neo4j (defaults match docker-compose.yml; for Aura use your neo4j+s://... URI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant (defaults match docker-compose.yml; leave QDRANT_API_KEY unset for local/self-hosted)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=graph_rag_chunks

# Routing: complexity score (0-1) at/above which queries go to the large model
ROUTING_THRESHOLD=0.5
