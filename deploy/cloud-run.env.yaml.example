# OPTIONAL, PAID-INFRA PATH. Cloud Run requires a GCP project with a billing
# account (a card on file) even though usage stays within the free tier — if
# you don't have one, use Hugging Face Spaces instead (see the Space's
# README.md and scripts/deploy_hf_space.sh), which needs no card at all.
#
# Copy this file to deploy/cloud-run.env.yaml and fill in real values.
# deploy/cloud-run.env.yaml is gitignored — never commit real secrets here.
#
# Passed to `gcloud run deploy --env-vars-file=deploy/cloud-run.env.yaml`.
# YAML map of plain strings; every value becomes a container env var.

GROQ_API_KEY: "gsk_..."

# Neo4j AuraDB free tier — from the Aura console after creating an instance.
# Use the neo4j+s:// URI it gives you (TLS, required by Aura).
NEO4J_URI: "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USER: "neo4j"
NEO4J_PASSWORD: "the-password-aura-generated"

# Qdrant Cloud free tier — from the Qdrant Cloud console after creating a cluster.
QDRANT_URL: "https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY: "the-api-key-qdrant-cloud-gave-you"
QDRANT_COLLECTION: "graph_rag_chunks"

ROUTING_THRESHOLD: "0.5"
